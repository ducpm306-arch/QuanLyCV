PORT=8000
MONGO_URL=mongodb://127.0.0.1:27017/QuanLyCV

# API tương thích OpenAI. Có thể dùng OpenAI, Gemini OpenAI compatibility,
# hoặc một dịch vụ tương thích khác.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=thay_api_key_tai_day
AI_MODEL=thay_ten_model_tai_day

# Tùy chọn. Apache Tika mặc định chạy tại http://localhost:9998.
TIKA_SERVER_URL=http://localhost:9998
TIKA_TIMEOUT_MS=180000

# Tùy chọn. Cần khi muốn chuyển DOCX sang PDF bằng LibreOffice trên Windows.
DOCX_TO_PDF_BIN=C:\Program Files\LibreOffice\program\soffice.exe

# Tùy chọn. Bỏ trống để dùng templates/company-cv-template.docx.
# CV_TEMPLATE_PATH=D:\QuanLyCV\templates\company-cv-template.docx
